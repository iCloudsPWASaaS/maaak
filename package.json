{
  "name": "maaak-matrimony",
  "version": "1.0.0",
  "private": true,
  "description": "MAAAK - Premium Islamic Matrimony Platform (API-First Next.js + Supabase)",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "setup:db": "node --env-file=.env.local scripts/setup-db.mjs",
    "seed:admin": "npx tsx --env-file=.env.local scripts/seed-admin.mjs",
    "seed:questions": "npx tsx --env-file=.env.local scripts/seed-questions.ts",
    "migrate:supabase": "npx tsx --env-file=.env.local scripts/migrate-from-supabase.mjs",
    "test": "npx tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1177.0",
    "@supabase/supabase-js": "^2.119.0",
    "agora-rtc-sdk-ng": "^4.24.10",
    "agora-token": "^2.0.7",
    "clsx": "^2.1.1",
    "lucide-react": "0.468.0",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "pusher": "^5.3.2",
    "pusher-js": "^8.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stripe": "17.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3"
  }
}

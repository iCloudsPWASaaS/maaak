# ==============================================================================
# MAAAK - Premium Matrimony Platform Environment Configuration
# ==============================================================================

# 1. Site & Security Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
JWT_SECRET=replace-with-a-64-char-random-hex-secret

# 2. Supabase Configuration (Dedicated matrimony PostgreSQL schema & Storage)
# Note: Authentication is managed directly in matrimony.users & matrimony.auth_sessions
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_PUBLIC_SUPABASE_SCHEMA=matrimony

SUPABASE_SERVICE_ROLE_KEY=your_service_role_jwt_key
SUPABASE_SECRET_KEY=sb_secret_your_secret_key

SUPABASE_STORAGE_BUCKET=matrimony

# 3. Admin Bootstrap & API Security
ADMIN_EMAIL=admin@maaak.co.uk
ADMIN_PASSWORD=ChangeMeImmediately#2026
ADMIN_API_KEY=replace-with-secure-admin-api-key

# 4. Didit.me Identity Verification
DIDIT_ENABLED=true
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=15480d9c-b20f-45f7-ae86-9aa8f71e8a41
DIDIT_BASE_URL=https://verification.didit.me
DIDIT_WEBHOOK_SECRET=
DIDIT_CALLBACK=https://maaak.co.uk/user/verify-id/callback

# 5. Agora Voice & Video Calling
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE_KEY=your_agora_app_certificate_key
NEXT_PUBLIC_AGORA_APP_ID=your_agora_app_id

# 6. Pusher Real-Time Messaging & Notifications
ALLOW_PUSHER=1
PUSHER_APP_ID=your_pusher_app_id
PUSHER_APP_KEY=your_pusher_app_key
PUSHER_APP_SECRET=your_pusher_app_secret
PUSHER_APP_CLUSTER=eu
NEXT_PUBLIC_PUSHER_APP_KEY=your_pusher_app_key
NEXT_PUBLIC_PUSHER_APP_CLUSTER=eu

# 7. Stripe Official Payment Gateway (Subscriptions & 1-Month Free Trial)
STRIPE_ENABLED=true
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_PREMIUM_PLUS_PRICE_ID=
STRIPE_SUCCESS_URL=http://localhost:3000/subscription?checkout=success
STRIPE_CANCEL_URL=http://localhost:3000/subscription?checkout=cancelled
STRIPE_CUSTOMER_PORTAL_ENABLED=true

# 8. Feedback & Transactional Email Configuration
FEEDBACK_RECIPIENT_EMAIL=info@maaak.co.uk
SMTP_HOST=mx00.ionos.co.uk
SMTP_PORT=587
SMTP_USER=info@maaak.co.uk
SMTP_PASS=
SMTP_FROM="MAAAK Matrimony <info@maaak.co.uk>"

# 9. Dynamic Public Banner Images (SerpAPI Google Images)
SERPAPI_API_KEY=

